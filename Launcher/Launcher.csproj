<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<Version>1.4.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="RazorConsole.Core" Version="0.5.0" />
	</ItemGroup>

	<!-- 发布配置 -->
	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<PublishAot>false</PublishAot>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishAot>false</PublishAot>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	</PropertyGroup>

	<!-- 路径定义 -->
	<PropertyGroup>
		<RootDir>$(MSBuildProjectDirectory)\..\</RootDir>
		<OutputDir>$(RootDir)build\</OutputDir>
	</PropertyGroup>

	<!-- 准备 build 目录 -->
	<Target Name="PrepareBuildDir" AfterTargets="Publish">
		<RemoveDir Directories="$(OutputDir)" />
		<MakeDir Directories="$(OutputDir)" />
	</Target>

	<!-- 仅复制发布后的可执行文件到 build/ -->
	<Target Name="CopyLauncherFiles" AfterTargets="Publish" DependsOnTargets="PrepareBuildDir">
		<Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFolder="$(OutputDir)" SkipUnchangedFiles="true" />
	</Target>

	<!-- 复制 nonebot 到 build/nonebot -->
	<Target Name="CopyNonebot" AfterTargets="Publish" DependsOnTargets="CopyLauncherFiles">
		<Exec Command="robocopy &quot;$(RootDir)multi_echo&quot; &quot;$(OutputDir)nonebot&quot; /E /XD .venv __pycache__ .idea .jbeval .vscode data /XF multi_echo.db multi_echo_candy.db .env.multi_echo .env.multi_echo_candy " IgnoreExitCode="true" />
		<Copy SourceFiles="$(RootDir)README.md" DestinationFolder="$(OutputDir)" />
	</Target>

	<!-- 下载并解压 NapCat 到 build/napcat1 -->
	<Target Name="DownloadNapCat" AfterTargets="Publish" DependsOnTargets="CopyNonebot">
		<PropertyGroup>
			<NapcatVersion>v4.18.28</NapcatVersion>
			<NapcatUrl>https://github.com/NapNeko/NapCatQQ/releases/download/$(NapcatVersion)/NapCat.Shell.zip</NapcatUrl>
			<NapcatZip>$(OutputDir)NapCat.zip</NapcatZip>
			<NapcatExtractDir>$(OutputDir)napcat1</NapcatExtractDir>
		</PropertyGroup>
		<Exec Command="powershell -Command &quot;Invoke-WebRequest -Uri $(NapcatUrl) -OutFile &quot;$(NapcatZip)&quot;&quot;" />
		<Exec Command="powershell -Command &quot;Expand-Archive -Path &quot;$(NapcatZip)&quot; -DestinationPath &quot;$(NapcatExtractDir)&quot; -Force&quot;" />
		<Delete Files="$(NapcatZip)" />
	</Target>

	<!-- 在 NapCat 的 config 目录中创建 onebot11.json 配置文件 -->
	<Target Name="CreateNapCatConfig" AfterTargets="Publish" DependsOnTargets="DownloadNapCat">
		<PropertyGroup>
			<NapcatConfigDir>$(OutputDir)napcat1\config</NapcatConfigDir>
		</PropertyGroup>
		<MakeDir Directories="$(NapcatConfigDir)" />
		<Copy SourceFiles="$(MSBuildProjectDirectory)\onebot11.json" DestinationFiles="$(NapcatConfigDir)\onebot11.json" SkipUnchangedFiles="true" />
	</Target>

	<!-- 压缩 build 目录并打开文件夹 -->
	<Target Name="ZipAndOpen" AfterTargets="CreateNapCatConfig">
		<PropertyGroup>
			<ZipVersion Condition="'$(Version)' != ''">$(Version)</ZipVersion>
			<ZipFileName>$(AssemblyName)-Candy-$(ZipVersion)-$(RuntimeIdentifier).zip</ZipFileName>
			<ZipFilePath>$(OutputDir)$(ZipFileName)</ZipFilePath>
		</PropertyGroup>
		<Message Text="Creating zip: $(ZipFilePath)" Importance="high" />
		<Exec Command="powershell -NoProfile -Command &quot;Compress-Archive -Path &quot;$(OutputDir)*&quot; -DestinationPath &quot;$(ZipFilePath)&quot; -Force&quot;" IgnoreExitCode="false" />
		<Message Text="Opening folder: $(OutputDir)" Importance="high" />
		<Exec Command="explorer &quot;$(OutputDir)&quot;" IgnoreExitCode="true" />
	</Target>
</Project>